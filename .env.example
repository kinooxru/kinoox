# ───────────────────────────────────────────────────────────────
#  KINOOX.RU — пример окружения
#  Скопируйте в .env и заполните значения.
#  Файл .env в git не попадает.
# ───────────────────────────────────────────────────────────────

# ── Общее ──────────────────────────────────────────────────────
NODE_ENV=development
TZ=Europe/Moscow
DOMAIN=kinoox.ru
SERVER_IP=95.216.97.185
SSL_EMAIL=admin@kinoox.ru

# ── PostgreSQL 16 ──────────────────────────────────────────────
DB_USER=kinoox
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=kinoox_db
DATABASE_URL=postgresql://kinoox:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/kinoox_db?schema=public

# ── Redis 7 ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── API (Fastify) ──────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=https://kinoox.ru/api/v1
CORS_ORIGINS=https://kinoox.ru,https://www.kinoox.ru,http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Балансеры видео ────────────────────────────────────────────
# Режим работы: real — реальные запросы к балансерам, mock — заглушки.
PLAYERS_MODE=mock
PLAYERS_TIMEOUT_MS=8000
PLAYERS_CACHE_TTL=600

# Vibix (vibix.org)
VIBIX_API_BASE=https://vibix.org
VIBIX_API_KEY=31210|hlO2TSwm6JCjPhglK8pCuzeSP7BVObXxBTmCJEvB052149a9
VIBIX_PUBLISHER_ID=674093403
VIBIX_PRIORITY=1

# VeoVeo APIs and iframe player
VEOVEO_API_BASE=https://webmaster-api.rstprgapipt.com
VEOVEO_CATALOG_SYNC_BASE=https://catalog-sync-api.rstprgapipt.com
# Optional fallback domain; resolved dynamically from VeoVeo when unset
VEOVEO_PLAYER_DOMAIN=
VEOVEO_API_TOKEN=CHANGE_ME_VEOVEO_TOKEN
VEOVEO_PRIORITY=2

# ── Сайт (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://kinoox.ru/api/v1
NEXT_PUBLIC_SOCKET_URL=https://kinoox.ru
NEXT_PUBLIC_SITE_URL=https://kinoox.ru

# ── Мобильное приложение (Expo / EAS) ──────────────────────────
EXPO_PUBLIC_API_URL=https://kinoox.ru/api/v1
EXPO_PUBLIC_SOCKET_URL=https://kinoox.ru
EAS_PROJECT_ID=

# ── Десктопное приложение (Tauri) ──────────────────────────────
VITE_API_URL=https://kinoox.ru/api/v1

# ── MinIO (S3-хранилище сборок) ────────────────────────────────
MINIO_ROOT_USER=kinooxadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_DOWNLOADS=downloads
MINIO_BUCKET_SCREENSHOTS=screenshots
MINIO_BUCKET_BACKUPS=backups

# ── Админ-интерфейсы ───────────────────────────────────────────
ADMINER_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Почта (noreply@kinoox.ru) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@kinoox.ru
SMTP_PASSWORD=
MAIL_FROM=noreply@kinoox.ru

# ── Push-уведомления ───────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
