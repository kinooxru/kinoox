{
  "title": "KINOOX — обзор сервиса",
  "uid": "kinoox-overview",
  "tags": ["kinoox", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступность API",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"kinoox-api\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Время работы",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "time() - process_start_time_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Загрузка CPU хоста",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Память хоста",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Свободно на диске",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / 1024 / 1024 / 1024",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decgbytes" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Контейнеров запущено",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "count(container_last_seen{name=~\"kinoox-.*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU по контейнерам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"kinoox-.*\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Память по контейнерам",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\"kinoox-.*\"}) / 1024 / 1024 / 1024",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decgbytes" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Сеть: трафик",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\"kinoox-.*\"}[5m]))",
          "refId": "A",
          "legendFormat": "входящий"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{name=~\"kinoox-.*\"}[5m]))",
          "refId": "B",
          "legendFormat": "исходящий"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Диск: операции ввода-вывода",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total[5m])", "refId": "A", "legendFormat": "чтение {{device}}" },
        { "expr": "rate(node_disk_written_bytes_total[5m])", "refId": "B", "legendFormat": "запись {{device}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Логи KINOOX",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\".+\"} |= ``",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
