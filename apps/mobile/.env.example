# ─────────────────────────────────────────────────────────────
#  KINOOX — переменные окружения мобильного приложения
#  Expo читает переменные с префиксом EXPO_PUBLIC_
# ─────────────────────────────────────────────────────────────

# Адрес API. Для эмулятора Android localhost хоста — 10.0.2.2
EXPO_PUBLIC_API_URL=https://kinoox.ru/api/v1
EXPO_PUBLIC_SOCKET_URL=https://kinoox.ru

# Идентификатор проекта EAS для push-уведомлений и сборки
EAS_PROJECT_ID=