{
  "name": "@kinoox/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "KINOOX Desktop — нативный клиент для Windows, macOS и Linux (Tauri 2)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:macos": "tauri build --bundles dmg,app",
    "build:linux": "tauri build --bundles appimage,deb,rpm",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint yet\"",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@kinoox/api-client": "workspace:*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.3.0",
    "@tauri-apps/plugin-window-state": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}